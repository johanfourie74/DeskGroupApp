<UserControl x:Class="DeskGroup.Controls.IconTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="72" d:DesignHeight="88"
             HorizontalAlignment="Stretch">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <!-- Default: No tooltip (for views with labels) -->
            <Setter Property="ToolTip" Value="{x:Null}"/>
            <Style.Triggers>
                <!-- Only show tooltip when label is hidden (icon-only views like Compact) -->
                <DataTrigger Binding="{Binding ShowLabel, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="ToolTip" Value="{Binding DisplayName, RelativeSource={RelativeSource Self}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Storyboard x:Key="HoverIn">
            <DoubleAnimation Storyboard.TargetName="HoverBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="0.3" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.08" Duration="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.08" Duration="0:0:0.1"/>
        </Storyboard>
        <Storyboard x:Key="HoverOut">
            <DoubleAnimation Storyboard.TargetName="HoverBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.0" Duration="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.0" Duration="0:0:0.1"/>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <ScaleTransform x:Name="ScaleTransform" CenterX="36" CenterY="44"
                        ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>

    <Grid x:Name="RootGrid" MouseEnter="Grid_MouseEnter" MouseLeave="Grid_MouseLeave">
        <!-- Hover highlight with accent border (uses group color if provided) -->
        <Border x:Name="HoverBorder"
                CornerRadius="6"
                BorderBrush="{Binding AccentColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue={StaticResource AccentPrimary}}"
                BorderThickness="2"
                Background="{DynamicResource BackgroundTertiary}"
                Opacity="0"/>

        <!-- Content -->
        <StackPanel x:Name="ContentPanel"
                    Orientation="{Binding LayoutOrientation, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <!-- Default: Centered with full margin (for Vertical orientation) -->
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="4"/>
                    <Style.Triggers>
                        <!-- Horizontal orientation: Left-aligned with minimal vertical margin -->
                        <DataTrigger Binding="{Binding LayoutOrientation, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Horizontal">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                            <Setter Property="Margin" Value="4,2,4,2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- Icon -->
            <Border Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=48}"
                    Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=48}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Default: Symmetric margins (for Vertical orientation) -->
                        <Setter Property="Margin" Value="0,2,0,2"/>
                        <Style.Triggers>
                            <!-- Horizontal orientation: Add right margin between icon and text -->
                            <DataTrigger Binding="{Binding LayoutOrientation, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Horizontal">
                                <Setter Property="Margin" Value="0,2,8,2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Image x:Name="IconImage"
                       Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Label -->
            <TextBlock x:Name="LabelText"
                       Text="{Binding DisplayName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource ForegroundPrimary}"
                       FontFamily="{DynamicResource DefaultFont}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       VerticalAlignment="Center"
                       Visibility="{Binding ShowLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- Default: Centered with MaxWidth (for Vertical orientation) -->
                        <Setter Property="TextAlignment" Value="Center"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="MaxWidth" Value="68"/>
                        <Style.Triggers>
                            <!-- Horizontal orientation: Left-aligned, no MaxWidth (stretch to fill) -->
                            <DataTrigger Binding="{Binding LayoutOrientation, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="Horizontal">
                                <Setter Property="TextAlignment" Value="Left"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="MaxWidth" Value="1000"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- Click overlay (invisible, allows mouse events to pass through for hover) -->
        <Border Background="Transparent"
                Cursor="Hand"
                IsHitTestVisible="True">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick"
                              Command="{Binding LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <MouseBinding Gesture="LeftClick"
                              Command="{Binding SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Border.InputBindings>
        </Border>
    </Grid>
</UserControl>