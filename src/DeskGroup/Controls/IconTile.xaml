<UserControl x:Class="DeskGroup.Controls.IconTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="72" d:DesignHeight="88"
             Width="{Binding TileWidth, RelativeSource={RelativeSource Self}, FallbackValue=72}"
             Height="{Binding TileHeight, RelativeSource={RelativeSource Self}, FallbackValue=88}"
             ToolTip="{Binding DisplayName, RelativeSource={RelativeSource Self}}">

    <UserControl.Resources>
        <Storyboard x:Key="HoverIn">
            <DoubleAnimation Storyboard.TargetName="HoverBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="0.3" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.08" Duration="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.08" Duration="0:0:0.1"/>
        </Storyboard>
        <Storyboard x:Key="HoverOut">
            <DoubleAnimation Storyboard.TargetName="HoverBorder"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleX"
                             To="1.0" Duration="0:0:0.1"/>
            <DoubleAnimation Storyboard.TargetName="ScaleTransform"
                             Storyboard.TargetProperty="ScaleY"
                             To="1.0" Duration="0:0:0.1"/>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <ScaleTransform x:Name="ScaleTransform" CenterX="36" CenterY="44"
                        ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>

    <Grid x:Name="RootGrid" MouseEnter="Grid_MouseEnter" MouseLeave="Grid_MouseLeave">
        <!-- Hover highlight with accent border (uses group color if provided) -->
        <Border x:Name="HoverBorder"
                CornerRadius="6"
                BorderBrush="{Binding AccentColor, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue={StaticResource AccentPrimary}}"
                BorderThickness="2"
                Background="{DynamicResource BackgroundTertiary}"
                Opacity="0"/>

        <!-- Content -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="4">
            <!-- Icon -->
            <Border Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=48}"
                    Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=48}"
                    HorizontalAlignment="Center"
                    Margin="0,2,0,4">
                <Image x:Name="IconImage"
                       Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Label -->
            <TextBlock x:Name="LabelText"
                       Text="{Binding DisplayName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource ForegroundPrimary}"
                       FontFamily="{DynamicResource DefaultFont}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       MaxWidth="68"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Click overlay (invisible, allows mouse events to pass through for hover) -->
        <Border Background="Transparent"
                Cursor="Hand"
                IsHitTestVisible="True">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick"
                              Command="{Binding LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                <MouseBinding Gesture="LeftClick"
                              Command="{Binding SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Border.InputBindings>
        </Border>
    </Grid>
</UserControl>