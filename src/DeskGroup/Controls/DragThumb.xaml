<UserControl x:Class="DeskGroup.Controls.DragThumb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="200" d:DesignHeight="28"
             Cursor="SizeAll"
             Background="Transparent">

    <UserControl.Resources>
        <Storyboard x:Key="DragActiveIn">
            <DoubleAnimation Storyboard.TargetName="DragIndicator"
                             Storyboard.TargetProperty="Opacity"
                             To="1" Duration="0:0:0.15"/>
        </Storyboard>
        <Storyboard x:Key="DragActiveOut">
            <DoubleAnimation Storyboard.TargetName="DragIndicator"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.2"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Height="28">
        <!-- Invisible drag surface (full width) -->
        <Border Background="Transparent"
                x:Name="DragSurface"/>

        <!-- Visual drag handle dots (center) -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Opacity="0.4">
            <!-- 6 dots in 2 rows of 3 -->
            <Grid Width="20" Height="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Row="0" Grid.Column="0" Width="3" Height="3"
                         Fill="{DynamicResource ForegroundSecondary}"/>
                <Ellipse Grid.Row="0" Grid.Column="1" Width="3" Height="3"
                         Fill="{DynamicResource ForegroundSecondary}"/>
                <Ellipse Grid.Row="0" Grid.Column="2" Width="3" Height="3"
                         Fill="{DynamicResource ForegroundSecondary}"/>
                <Ellipse Grid.Row="1" Grid.Column="0" Width="3" Height="3"
                         Fill="{DynamicResource ForegroundSecondary}"/>
                <Ellipse Grid.Row="1" Grid.Column="1" Width="3" Height="3"
                         Fill="{DynamicResource ForegroundSecondary}"/>
                <Ellipse Grid.Row="1" Grid.Column="2" Width="3" Height="3"
                         Fill="{DynamicResource ForegroundSecondary}"/>
            </Grid>
        </StackPanel>

        <!-- "Dragging" indicator (shown while actively dragging) -->
        <Border x:Name="DragIndicator"
                CornerRadius="4"
                Background="{DynamicResource AccentPrimary}"
                Opacity="0"
                IsHitTestVisible="False"
                Height="3"
                VerticalAlignment="Bottom"
                Margin="8,0,8,0"/>

        <!-- Pin indicator (shown when pinned) -->
        <TextBlock x:Name="PinIcon"
                   Text="ðŸ“Œ"
                   FontSize="10"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="0,0,4,0"
                   Visibility="{Binding IsPinnedVisible, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=Collapsed}"
                   IsHitTestVisible="False"
                   ToolTip="Position pinned"/>
    </Grid>
</UserControl>