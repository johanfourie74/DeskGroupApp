<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================================== -->
    <!-- STANDARD WINDOWS 11 LIGHT THEME -->
    <!-- Native Windows appearance for group windows -->
    <!-- ====================================================================== -->

    <!-- Background Colors -->
    <SolidColorBrush x:Key="BackgroundPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BackgroundSecondary" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="BackgroundTertiary" Color="#E6E6E6"/>

    <!-- Foreground Colors -->
    <SolidColorBrush x:Key="ForegroundPrimary" Color="#000000"/>
    <SolidColorBrush x:Key="ForegroundSecondary" Color="#605E5C"/>
    <SolidColorBrush x:Key="ForegroundDisabled" Color="#A19F9D"/>

    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderBrush" Color="#D1D1D1"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#E0E0E0"/>

    <!-- Accent Colors (Windows 11 Blue) -->
    <SolidColorBrush x:Key="AccentPrimary" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHover" Color="#106EBE"/>
    <SolidColorBrush x:Key="AccentPressed" Color="#005A9E"/>

    <!-- Fonts -->
    <FontFamily x:Key="DefaultFont">Segoe UI</FontFamily>
    <system:Double x:Key="FontSizeSmall" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="FontSizeNormal" xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>
    <system:Double x:Key="FontSizeLarge" xmlns:system="clr-namespace:System;assembly=mscorlib">16</system:Double>
    <system:Double x:Key="FontSizeTitle" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>

</ResourceDictionary>
