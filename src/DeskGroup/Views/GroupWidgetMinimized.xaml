<UserControl x:Class="DeskGroup.Views.GroupWidgetMinimized"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="160" d:DesignHeight="40">

    <!-- 
    Minimized view: A small pill/badge showing the group icon + group name.
    This is the default resting state of a group widget on the desktop.
    -->

    <UserControl.Resources>
        <Storyboard x:Key="PulseIn">
            <DoubleAnimation Storyboard.TargetName="PillBorder"
                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                             To="16" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PillBorder"
                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                             To="0.4" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="PulseOut">
            <DoubleAnimation Storyboard.TargetName="PillBorder"
                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.BlurRadius)"
                             To="8" Duration="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="PillBorder"
                             Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                             To="0.2" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard Storyboard="{StaticResource PulseIn}"/>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard Storyboard="{StaticResource PulseOut}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Border x:Name="PillBorder"
            CornerRadius="{DynamicResource PillCornerRadius}"
            Background="{Binding AccentBrush}"
            Padding="10,6"
            MinWidth="60"
            MaxWidth="200"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Cursor="Hand"
            ToolTip="{Binding Name}">

        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2"
                              Color="Black" Direction="270"/>
        </Border.Effect>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">

            <!-- Group Icon -->
            <Border Width="22" Height="22"
                    Margin="0,0,8,0"
                    CornerRadius="4"
                    Background="Transparent">
                <Image Source="{Binding GroupIcon}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GroupIcon}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Border>

            <!-- Folder icon fallback (when no custom icon is set) -->
            <TextBlock Text="FolderIcon"
                       FontSize="16"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GroupIcon}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Group Name -->
            <TextBlock Text="{Binding Name}"
                       Foreground="White"
                       FontFamily="{DynamicResource DefaultFont}"
                       FontSize="{DynamicResource FontSizeNormal}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="130"/>

            <!-- Shortcut count badge -->
            <Border CornerRadius="8"
                    Background="#40FFFFFF"
                    Padding="6,2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding AllShortcuts.Count}"
                           Foreground="White"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </Border>

        </StackPanel>
    </Border>
</UserControl>