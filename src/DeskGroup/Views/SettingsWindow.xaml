<Window x:Class="DeskGroup.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:DeskGroup.Models"
        xmlns:controls="clr-namespace:DeskGroup.Controls"
        xmlns:converters="clr-namespace:DeskGroup.Converters"
        mc:Ignorable="d"
        Title="DeskGroup Settings"
        Width="540" Height="600"
        MinWidth="460" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BooleanToVisibility"/>
        <converters:InverseBoolConverter      x:Key="InverseBool"/>

        <!-- Section header style with separator -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DefaultFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLarge}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
            <Setter Property="Margin" Value="0,20,0,12"/>
        </Style>

        <!-- Section separator line -->
        <Style x:Key="SectionSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>

        <!-- Setting label style -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DefaultFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Setting description style -->
        <Style x:Key="SettingDesc" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource DefaultFont}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>

        <!-- Row style for settings -->
        <Style x:Key="SettingRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,4,0,4"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundPrimary}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Title header -->
                <RowDefinition Height="Auto"/>   <!-- Tab menu bar -->
                <RowDefinition Height="*"/>      <!-- Scrollable content -->
                <RowDefinition Height="Auto"/>   <!-- Bottom buttons -->
            </Grid.RowDefinitions>

            <!-- Title Header (dynamic title based on active tab) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource BackgroundSecondary}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    Padding="24,16,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                MouseLeftButtonDown="SettingsHeader_MouseLeftButtonDown"
                                Cursor="SizeAll"
                                Background="Transparent">
                        <TextBlock x:Name="HeaderTitle"
                                   Text="Settings"
                                   FontFamily="{DynamicResource DefaultFont}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource ForegroundPrimary}"/>
                        <TextBlock x:Name="HeaderSubtitle"
                                   Text="Customize DeskGroup appearance and behavior"
                                   FontFamily="{DynamicResource DefaultFont}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource ForegroundSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="44"
                            Height="34"
                            Margin="0,-16,0,0"
                            Click="CloseButton_Click"
                            VerticalAlignment="Top"
                            Cursor="Hand"
                            Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="#C42B1C"
                                        CornerRadius="0,10,0,0">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#F1707A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="✕" Foreground="White" FontSize="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Tab Menu Bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BackgroundSecondary}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="24,8">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SettingsTabButton"
                            Content="Settings"
                            Click="SettingsTab_Click"
                            Style="{DynamicResource DefaultButton}"
                            Padding="16,6"
                            Margin="0,0,8,0"
                            FontWeight="SemiBold"
                            Background="{DynamicResource AccentBrush}"/>
                    <Button x:Name="AboutTabButton"
                            Content="About"
                            Click="AboutTab_Click"
                            Style="{DynamicResource DefaultButton}"
                            Padding="16,6"
                            Margin="0,0,8,0"/>
                    <Button x:Name="HelpTabButton"
                            Content="Help (F1)"
                            Click="HelpTab_Click"
                            Style="{DynamicResource DefaultButton}"
                            Padding="16,6"
                            Margin="0,0,8,0"/>
                    <Button x:Name="UpdatesTabButton"
                            Content="Updates"
                            Click="UpdatesTab_Click"
                            Style="{DynamicResource DefaultButton}"
                            Padding="16,6"/>
                </StackPanel>
            </Border>

        <!-- Scrollable content (Settings Panel) -->
        <ScrollViewer x:Name="SettingsPanel"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,8,24,8"
                      Visibility="Visible">

            <StackPanel>

                <!-- ====================================================================== -->
                <!-- APPEARANCE -->
                <!-- ====================================================================== -->
                <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}"/>

                <!-- UI Theme (for Settings window and dialogs ONLY) -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="UI Color Theme" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <ComboBox ItemsSource="{Binding ThemeModes}"
                              SelectedItem="{Binding Theme}"
                              Width="180"
                              HorizontalAlignment="Left"
                              Padding="8,4"/>
                </DockPanel>
                <TextBlock Text="Color scheme for Settings window and dialogs (Light/Dark/Follow System)."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Group Background Transparency -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Group Transparency" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="TransparencySlider"
                                Value="{Binding GroupBackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Minimum="0.0"
                                Maximum="1.0"
                                Width="150"
                                VerticalAlignment="Center"
                                TickPlacement="BottomRight"
                                TickFrequency="0.25"
                                Ticks="0.0, 0.25, 0.5, 0.75, 1.0"
                                IsSnapToTickEnabled="False"
                                SmallChange="0.05"
                                LargeChange="0.25"
                                PreviewMouseWheel="TransparencySlider_MouseWheel"/>
                        <TextBlock Text="{Binding GroupBackgroundOpacity, StringFormat={}{0:P0}}"
                                   FontFamily="{DynamicResource DefaultFont}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource ForegroundSecondary}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   MinWidth="45"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Text="Adjust transparency of group windows (100% = opaque, 0% = fully transparent). Changes apply immediately to all groups."
                           Style="{StaticResource SettingDesc}"/>

                <!-- ====================================================================== -->
                <!-- DESKTOP INTEGRATION -->
                <!-- ====================================================================== -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Desktop Integration" Style="{StaticResource SectionHeader}"/>

                <!-- Default dock mode -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Default dock mode" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <ComboBox ItemsSource="{Binding DockModes}"
                              SelectedItem="{Binding DefaultDockMode}"
                              Width="180"
                              HorizontalAlignment="Left"
                              Padding="8,4"/>
                </DockPanel>
                <TextBlock Text="Sticky = behind windows (like gadgets). Float = above windows."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Snap to grid -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Snap to grid" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding DefaultSnapToGrid}"
                              VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Grid size -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Grid size (px)" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <TextBox Text="{Binding SnapGridSize, UpdateSourceTrigger=PropertyChanged}"
                             Width="60"
                             HorizontalAlignment="Left"
                             Padding="6,4"
                             VerticalContentAlignment="Center"/>
                </DockPanel>

                <!-- Hide grouped icons -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Hide grouped icons" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding HideGroupedIcons}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="When enabled, desktop icons are hidden after being added to a group. They are restored when removed or the group is deleted."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Shell context menu -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Shell context menu" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding EnableShellContextMenu}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Adds 'Add to DeskGroup' to the right-click menu of .lnk, .url, .exe, and folder items in Explorer and on the desktop."
                           Style="{StaticResource SettingDesc}"/>

                <!-- ====================================================================== -->
                <!-- EDGE DOCK (OPTIONAL SIDE PANEL) -->
                <!-- ====================================================================== -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Edge Dock (Optional Side Panel)" Style="{StaticResource SectionHeader}"/>

                <!-- Enable Edge Dock -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Enable Side Panel" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding EnableEdgeDock}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Optional always-on-top edge dock panel (hidden by default on the left screen edge). Shows/hides independently even when all desktop groups are hidden."
                           Style="{StaticResource SettingDesc}"/>

                <StackPanel Visibility="{Binding EnableEdgeDock, Converter={StaticResource BooleanToVisibility}}">
                    <!-- Monitor Mode -->
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="Multi-monitor mode" Style="{StaticResource SettingLabel}"
                                   DockPanel.Dock="Left" Width="160"/>
                        <ComboBox ItemsSource="{Binding EdgeDockMonitorModes}"
                                  SelectedItem="{Binding EdgeDockMonitorMode}"
                                  Width="210"
                                  HorizontalAlignment="Left"
                                  Padding="8,4"/>
                    </DockPanel>
                    <TextBlock Text="MainMonitorOnly (default), SameForAllMonitors (mirrors panel on every screen), or PerMonitorCustom (independent edges and shortcuts per monitor)."
                               Style="{StaticResource SettingDesc}"/>

                    <!-- Target Monitor Selector (for configuring per-monitor or main monitor edges) -->
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="Configure monitor" Style="{StaticResource SettingLabel}"
                                   DockPanel.Dock="Left" Width="160"/>
                        <ComboBox ItemsSource="{Binding AvailableMonitors}"
                                  SelectedItem="{Binding SelectedMonitorOption}"
                                  DisplayMemberPath="DisplayName"
                                  Width="260"
                                  HorizontalAlignment="Left"
                                  Padding="8,4"/>
                    </DockPanel>

                    <!-- Active Screen Edges (1, 2, 3, or all 4 edges) -->
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="Active edges (1–4)" Style="{StaticResource SettingLabel}"
                                   DockPanel.Dock="Left" Width="160"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="Left" IsChecked="{Binding EdgeLeftEnabled}" Margin="0,0,12,0" Foreground="{DynamicResource ForegroundPrimary}"/>
                            <CheckBox Content="Top" IsChecked="{Binding EdgeTopEnabled}" Margin="0,0,12,0" Foreground="{DynamicResource ForegroundPrimary}"/>
                            <CheckBox Content="Right" IsChecked="{Binding EdgeRightEnabled}" Margin="0,0,12,0" Foreground="{DynamicResource ForegroundPrimary}"/>
                            <CheckBox Content="Bottom" IsChecked="{Binding EdgeBottomEnabled}" Foreground="{DynamicResource ForegroundPrimary}"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="Enable 1, 2, 3, or all 4 edges on the selected monitor. Default is Left edge."
                               Style="{StaticResource SettingDesc}"/>

                    <!-- Primary Edge quick selector -->
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="Default dock edge" Style="{StaticResource SettingLabel}"
                                   DockPanel.Dock="Left" Width="160"/>
                        <ComboBox ItemsSource="{Binding DockEdges}"
                                  SelectedItem="{Binding PrimaryDockEdge}"
                                  Width="180"
                                  HorizontalAlignment="Left"
                                  Padding="8,4"/>
                    </DockPanel>

                    <!-- Lock State -->
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="Dock lock mode" Style="{StaticResource SettingLabel}"
                                   DockPanel.Dock="Left" Width="160"/>
                        <ComboBox ItemsSource="{Binding EdgeDockLockStates}"
                                  SelectedItem="{Binding EdgeDockLockState}"
                                  Width="180"
                                  HorizontalAlignment="Left"
                                  Padding="8,4"/>
                    </DockPanel>
                    <TextBlock Text="AutoHide (default: hidden until edge hover or bubble click), LockedOpen (always visible on top), or LockedClosed."
                               Style="{StaticResource SettingDesc}"/>

                    <!-- Pin Dock Position -->
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="Pin dock position" Style="{StaticResource SettingLabel}"
                                   DockPanel.Dock="Left" Width="160"/>
                        <CheckBox IsChecked="{Binding EdgeDockIsPinned}"
                                  VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="When unpinned, drag the dock header or edge bubble to move along any edge or snap to Left, Top, Right, or Bottom. Pinning locks its position."
                               Style="{StaticResource SettingDesc}"/>

                    <!-- Show on Edge Hover -->
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="Show on edge hover" Style="{StaticResource SettingLabel}"
                                   DockPanel.Dock="Left" Width="160"/>
                        <CheckBox IsChecked="{Binding EdgeDockShowOnHover}"
                                  VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Always-on-top Edge Bubble Button -->
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="Show edge bubble" Style="{StaticResource SettingLabel}"
                                   DockPanel.Dock="Left" Width="160"/>
                        <CheckBox IsChecked="{Binding EdgeDockShowBubble}"
                                  VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Displays a non-intrusive, always-on-top edge bubble button for reliable show/hide on multi-monitor setups."
                               Style="{StaticResource SettingDesc}"/>

                    <!-- Bubble Size -->
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="Bubble size (px)" Style="{StaticResource SettingLabel}"
                                   DockPanel.Dock="Left" Width="160"/>
                        <Slider Value="{Binding EdgeDockBubbleSize}"
                                Minimum="12" Maximum="48"
                                Width="160"
                                TickFrequency="2"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EdgeDockBubbleSize, StringFormat={}{0}×{0}px}"
                                   Style="{StaticResource SettingLabel}"
                                   Margin="8,0,0,0"/>
                    </DockPanel>
                    <TextBlock Text="Default is 16×16px. You can also right-click the bubble or dock panel at any time to adjust size, pin, edge, or lock mode."
                               Style="{StaticResource SettingDesc}"/>

                    <!-- Edge Panel Icon Size (px) -->
                    <DockPanel Style="{StaticResource SettingRow}">
                        <TextBlock Text="Edge panel icon size" Style="{StaticResource SettingLabel}"
                                   DockPanel.Dock="Left" Width="160"/>
                        <Slider Value="{Binding EdgeDockIconSize}"
                                Minimum="16" Maximum="96"
                                Width="140"
                                TickFrequency="4"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EdgeDockIconSizeDisplayText}"
                                   Style="{StaticResource SettingLabel}"
                                   Margin="8,0,8,0"/>
                        <Button Content="Use Global"
                                Command="{Binding ResetEdgeDockIconSizeCommand}"
                                Style="{DynamicResource DefaultButton}"
                                Padding="8,2"
                                FontSize="11"
                                ToolTip="Reset Edge Panel icon size to follow the global icon size setting"/>
                    </DockPanel>
                    <TextBlock Text="Resize icons inside the Edge Panel (16–96px). You can also right-click anywhere inside the Edge Panel or on an icon → Icon Size."
                               Style="{StaticResource SettingDesc}"/>
                </StackPanel>

                <!-- ====================================================================== -->
                <!-- ICONS -->
                <!-- ====================================================================== -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Icons" Style="{StaticResource SectionHeader}"/>

                <!-- Icon size mode -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Icon size" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <ComboBox ItemsSource="{Binding IconSizeModes}"
                              SelectedItem="{Binding IconSizeMode}"
                              Width="180"
                              HorizontalAlignment="Left"
                              Padding="8,4"/>
                </DockPanel>
                <TextBlock Text="System = follow Windows icon size. Custom = set your own."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Custom size -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Custom size (px)" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <Slider Value="{Binding CustomIconSize}"
                            Minimum="24" Maximum="128"
                            Width="160"
                            TickFrequency="8"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CustomIconSize, StringFormat={}{0}px}"
                               Style="{StaticResource SettingLabel}"
                               Margin="8,0,0,0"/>
                </DockPanel>

                <!-- ====================================================================== -->
                <!-- HOTKEYS -->
                <!-- ====================================================================== -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <DockPanel Style="{StaticResource SettingRow}"><TextBlock Text="Edge panel icon size" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="160"/><Slider Value="{Binding EdgeDockIconSize}" Minimum="16" Maximum="96" Width="140" TickFrequency="4" IsSnapToTickEnabled="True" VerticalAlignment="Center"/><TextBlock Text="{Binding EdgeDockIconSizeDisplayText}" Style="{StaticResource SettingLabel}" Margin="8,0,8,0"/><Button Content="Use Global" Command="{Binding ResetEdgeDockIconSizeCommand}" Style="{DynamicResource DefaultButton}" Padding="8,2" FontSize="11" ToolTip="Reset Edge Panel icon size to follow the global icon size setting"/></DockPanel>
                <TextBlock Text="Controls the icon size within Edge Dock side panels (16–96px), or click Use Global to match desktop groups." Style="{StaticResource SettingDesc}"/>
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}"/>

                <!-- Toggle all — mode selector -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Show/Hide all groups" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <ComboBox ItemsSource="{Binding HotkeyModes}"
                              SelectedItem="{Binding ToggleAllHotkeyMode}"
                              Width="90" HorizontalAlignment="Left"/>
                </DockPanel>
                <!-- Toggle all — keyboard + mouse boxes -->
                <DockPanel Margin="160,0,0,8">
                    <TextBlock Text="⌨️" VerticalAlignment="Center" Margin="0,0,4,0"
                               FontSize="13" ToolTip="Keyboard hotkey"/>
                    <controls:HotkeyBox HotkeyValue="{Binding ToggleAllHotkey, UpdateSourceTrigger=PropertyChanged}"
                                        CaptureMode="KeyboardOnly"
                                        Width="156" HorizontalAlignment="Left"/>
                    <TextBlock Text="🖱️" VerticalAlignment="Center" Margin="8,0,4,0"
                               FontSize="13" ToolTip="Mouse hotkey"/>
                    <controls:HotkeyBox HotkeyValue="{Binding ToggleAllMouseHotkey, UpdateSourceTrigger=PropertyChanged}"
                                        CaptureMode="MouseOnly"
                                        Width="156" HorizontalAlignment="Left"/>
                </DockPanel>

                <!-- Fullscreen toggle — mode selector -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Toggle fullscreen" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <ComboBox ItemsSource="{Binding HotkeyModes}"
                              SelectedItem="{Binding FullscreenHotkeyMode}"
                              Width="90" HorizontalAlignment="Left"/>
                </DockPanel>
                <!-- Fullscreen toggle — keyboard + mouse boxes -->
                <DockPanel Margin="160,0,0,8">
                    <TextBlock Text="⌨️" VerticalAlignment="Center" Margin="0,0,4,0"
                               FontSize="13" ToolTip="Keyboard hotkey"/>
                    <controls:HotkeyBox HotkeyValue="{Binding FullscreenToggleHotkey, UpdateSourceTrigger=PropertyChanged}"
                                        CaptureMode="KeyboardOnly"
                                        Width="156" HorizontalAlignment="Left"/>
                    <TextBlock Text="🖱️" VerticalAlignment="Center" Margin="8,0,4,0"
                               FontSize="13" ToolTip="Mouse hotkey"/>
                    <controls:HotkeyBox HotkeyValue="{Binding FullscreenMouseHotkey, UpdateSourceTrigger=PropertyChanged}"
                                        CaptureMode="MouseOnly"
                                        Width="156" HorizontalAlignment="Left"/>
                </DockPanel>
                <DockPanel Style="{StaticResource SettingRow}"><TextBlock Text="Show/Hide side panel" Style="{StaticResource SettingLabel}" DockPanel.Dock="Left" Width="160"/><ComboBox ItemsSource="{Binding HotkeyModes}" SelectedItem="{Binding ToggleEdgeDockHotkeyMode}" Width="90" HorizontalAlignment="Left"/></DockPanel>
                <DockPanel Margin="160,0,0,6"><TextBlock Text="⌨️" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13" ToolTip="Keyboard hotkey (e.g. Ctrl+Alt+Left)"/><controls:HotkeyBox HotkeyValue="{Binding ToggleEdgeDockHotkey, UpdateSourceTrigger=PropertyChanged}" CaptureMode="KeyboardOnly" Width="156" HorizontalAlignment="Left"/><TextBlock Text="🖱️" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="13" ToolTip="Mouse hotkey"/><controls:HotkeyBox HotkeyValue="{Binding ToggleEdgeDockMouseHotkey, UpdateSourceTrigger=PropertyChanged}" CaptureMode="MouseOnly" Width="156" HorizontalAlignment="Left"/></DockPanel>
                <DockPanel Style="{StaticResource SettingRow}" Margin="160,0,0,8"><CheckBox IsChecked="{Binding EnableEdgeDockArrowHotkeys}" Content="Arrow keys match dock edge (e.g. Ctrl+Alt + Left/Up/Right/Down)" Foreground="{DynamicResource ForegroundPrimary}" VerticalAlignment="Center"/></DockPanel>
                <TextBlock Text="Click 🎯 (or click inside a mouse shortcut box) to record, or click ✕ to clear. Setting a mouse or keyboard shortcut automatically enables its mode. Mouse supports MiddleClick, XButton1/2, ScrollUp/Down, or Ctrl/Alt/Shift + LeftClick/RightClick."
                           Style="{StaticResource SettingDesc}"/>

                <!-- ====================================================================== -->
                <!-- STARTUP & BEHAVIOR -->
                <!-- ====================================================================== -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Startup &amp; Behavior" Style="{StaticResource SectionHeader}"/>

                <!-- Start with Windows -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Start with Windows" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding StartWithWindows}"
                              VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Start minimized -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Start minimized to tray" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding StartMinimizedToTray}"
                              VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Watch for ungrouped -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Detect new desktop icons" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding WatchForUngroupedIcons}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="When enabled, DeskGroup will notify you when new shortcuts appear on your desktop so you can sort them into groups."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Single-click to launch -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Single-click to open" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding SingleClickToLaunch}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="When enabled, shortcuts open with a single click. Default (unchecked) requires a double-click."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Multi-monitor -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Multi-monitor support" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding AllowMultiMonitor}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Allow groups to be placed on any connected monitor."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Desktop shortcut -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Desktop shortcut" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding DesktopShortcutInstalled}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Create or remove the DeskGroup shortcut on your desktop."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Pin to Start menu -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Pin to Start menu" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding PinnedToStart}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Creates or removes the DeskGroup shortcut in your Windows Start Menu Programs list."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Pin to taskbar -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Pin to taskbar" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding PinnedToTaskbar}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Track whether DeskGroup is pinned to the taskbar. Enabling this attempts to pin it automatically (Windows 11 may require right-clicking the running icon → Pin to taskbar)."
                           Style="{StaticResource SettingDesc}"/>

                <!-- ====================================================================== -->
                <!-- DEVELOPER -->
                <!-- ====================================================================== -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Developer" Style="{StaticResource SectionHeader}"/>

                <!-- Show debug menu -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Show debug menu" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding ShowDebugMenu}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Shows diagnostic items in the tray right-click menu."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Opt-in bug reporting -->
                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Opt-in for bug reports" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding OptInBugReporting}"
                              VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="If DeskGroup crashes, you will be asked whether to report the issue on GitHub. No data is sent automatically — it only opens a pre-filled GitHub Issues page in your browser so you can review and submit it yourself."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Bottom spacer -->
                <Border Height="16"/>

            </StackPanel>
        </ScrollViewer>

        <!-- About Panel -->
        <ScrollViewer x:Name="AboutPanel"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,24,24,24"
                      Visibility="Collapsed">
            <StackPanel MaxWidth="450">
                <!-- App Info -->
                <TextBlock Text="DeskGroup"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,8"/>

                <TextBlock x:Name="VersionText"
                           Text="Version 1.4.6"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource ForegroundSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Description -->
                <TextBlock Text="DeskGroup helps you organize your desktop shortcuts into collapsible groups, keeping your desktop clean and your workflow efficient."
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,32"/>

                <!-- Separator -->
                <Border Height="1"
                        Background="{DynamicResource BorderSubtle}"
                        Margin="0,0,0,24"/>

                <!-- Author -->
                <TextBlock Text="Created by"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource ForegroundSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Johan Fourie"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeLarge}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Links -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                    <Button Content="🌐 GitHub"
                            Click="GitHub_Click"
                            Style="{DynamicResource DefaultButton}"
                            Padding="12,6"
                            Margin="0,0,8,0"/>
                    <Button Content="📧 Contact"
                            Click="Contact_Click"
                            Style="{DynamicResource DefaultButton}"
                            Padding="12,6"
                            Margin="0,0,8,0"/>
                    <Button Content="🐛 Report a Bug"
                            Click="ReportBug_Click"
                            Style="{DynamicResource DefaultButton}"
                            Padding="12,6"/>
                </StackPanel>

                <!-- Copyright -->
                <TextBlock x:Name="CopyrightText"
                           Text="© 2025 Johan Fourie. All rights reserved."
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource ForegroundSecondary}"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Help Panel -->
        <ScrollViewer x:Name="HelpPanel"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,24,24,24"
                      Visibility="Collapsed">
            <StackPanel MaxWidth="550">
                <!-- Quick Start -->
                <TextBlock Text="Quick Start"
                           Style="{StaticResource SectionHeader}"/>

                <TextBlock TextWrapping="Wrap"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           Margin="0,0,0,16">
                    <Run Text="1. Create a group:"/>
                    <Run Text=" Right-click the tray icon → New Group" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="2. Add shortcuts:"/>
                    <Run Text=" Drag desktop icons onto a group, or right-click group → Add shortcut" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="3. Customize:"/>
                    <Run Text=" Right-click group → Appearance to change color, icon, per-group icon size or opacity; Rename to rename" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="4. Choose how it looks:"/>
                    <Run Text=" Right-click group → View Mode (Minimized, Compact, Normal, Grid, Fullscreen)" Foreground="{DynamicResource ForegroundSecondary}"/>
                </TextBlock>

                <!-- View Modes -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="View Modes"
                           Style="{StaticResource SectionHeader}"/>

                <TextBlock TextWrapping="Wrap"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           Margin="0,0,0,16">
                    <Run FontWeight="SemiBold" Text="Minimized:"/>
                    <Run Text=" Compact pill showing group name and shortcut count" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Hover:"/>
                    <Run Text=" Auto-expands on hover; shows top 5 most-used shortcuts; auto-collapses when mouse leaves" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Compact:"/>
                    <Run Text=" Icons-only grid (1-2 rows); hover an icon to see its name" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Normal:"/>
                    <Run Text=" Icons with labels in a vertical list; drag the corner grip to resize" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Grid:"/>
                    <Run Text=" Icons with labels in a multi-column grid; drag the corner grip to resize" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Fullscreen:"/>
                    <Run Text=" Full-screen grid view; press F11 or ESC to exit" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Tip:"/>
                    <Run Text=" Normal and Grid each remember their own independent size" Foreground="{DynamicResource ForegroundSecondary}"/>
                </TextBlock>

                <!-- Right-Click Menu -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Right-Click Menu"
                           Style="{StaticResource SectionHeader}"/>

                <TextBlock TextWrapping="Wrap"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           Margin="0,0,0,16">
                    <Run Text="Right-click anywhere on a group window:" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="View Mode &#x2192;"/>
                    <Run Text=" Switch between Minimized, Compact, Normal, Grid, Fullscreen" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Add shortcut:"/>
                    <Run Text=" Browse and add a .lnk, .url or .exe file" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Appearance &#x2192;"/>
                    <Run Text=" Sub-menu with four options:" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="        Change color... " FontWeight="SemiBold"/>
                    <Run Text="Pick from 22 Windows 11 accent colors or enter a custom hex color" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="        Change icon... " FontWeight="SemiBold"/>
                    <Run Text="Set a custom emoji or text icon shown in the group header" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="        Icon Size &amp; Opacity... " FontWeight="SemiBold"/>
                    <Run Text="Override icon size (16–96 px) and background opacity for this group only; set to minimum to follow the global setting" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="        Reset Appearance " FontWeight="SemiBold"/>
                    <Run Text="Restore this group's color, icon, size and opacity to global defaults" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Position &#x2192;"/>
                    <Run Text=" Pin position, toggle snap-to-grid, or switch Sticky/Float layer" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Rename:"/>
                    <Run Text=" Give the group a new name" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Show / Hide All:"/>
                    <Run Text=" Toggle visibility of all groups at once" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Delete group:"/>
                    <Run Text=" Permanently removes the group; shortcuts are restored to the desktop" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="&#x2699;&#xFE0F; Settings:"/>
                    <Run Text=" Open the Settings window" Foreground="{DynamicResource ForegroundSecondary}"/>
                </TextBlock>

                <!-- Dock Modes -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Dock Modes"
                           Style="{StaticResource SectionHeader}"/>

                <TextBlock TextWrapping="Wrap"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           Margin="0,0,0,16">
                    <Run FontWeight="SemiBold" Text="Sticky:"/>
                    <Run Text=" Group stays behind windows (like desktop gadgets)" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Float:"/>
                    <Run Text=" Group stays above all windows" Foreground="{DynamicResource ForegroundSecondary}"/>
                </TextBlock>

                <!-- Edge Dock (Optional Side Panel) -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Edge Dock (Side Panel)"
                           Style="{StaticResource SectionHeader}"/>

                <TextBlock TextWrapping="Wrap"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           Margin="0,0,0,16">
                    <Run FontWeight="SemiBold" Text="Independent Visibility:"/>
                    <Run Text=" The optional Side Panel hides and shows on its own, even when all desktop groups are hidden" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="4 Dock Edges &amp; Pin:"/>
                    <Run Text=" Defaults to the Left edge (auto-hidden). Drag the dock header or bubble to dock to Left, Top, Right, or Bottom edges, then click Pin (📌) to lock it" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Multi-Monitor &amp; 1–4 Edges:"/>
                    <Run Text=" Choose Main Monitor Only (default), Same Panel for All Monitors, or Per-Monitor Custom with 1, 2, 3, or all 4 edges active per screen and independent shortcuts" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Always-on-Top Edge Bubble:"/>
                    <Run Text=" A non-intrusive 16×16px (customizable 12–48px) always-on-top edge bubble lets you reliably hover or click to show/hide the dock on multi-monitor edges" Foreground="{DynamicResource ForegroundSecondary}"/>
                </TextBlock>

                <!-- Keyboard Shortcuts -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Keyboard Shortcuts"
                           Style="{StaticResource SectionHeader}"/>

                <TextBlock TextWrapping="Wrap"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           Margin="0,0,0,16">
                    <Run FontWeight="SemiBold" Text="F1:"/>
                    <Run Text=" Show this help dialog" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="F11:"/>
                    <Run Text=" Toggle fullscreen mode (when group is active)" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="ESC:"/>
                    <Run Text=" Exit fullscreen mode" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Ctrl+F2:"/>
                    <Run Text=" Show/Hide all groups (default; fully configurable in Settings — keyboard, mouse button, or both)" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Ctrl+Alt+Left / Arrow Keys:"/>
                    <Run Text=" Show/Hide Side Panel (Edge Dock). When directional arrow matching is enabled, pressing the modifier + Left/Up/Right/Down arrow toggles the corresponding screen edge dock!" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Mouse hotkeys:"/>
                    <Run Text=" Assign MiddleClick, XButton1/2, ScrollUp/Down, or Ctrl/Alt/Shift + LeftClick/RightClick as triggers; click 🎯 or inside the mouse box to record, or ✕ to clear" Foreground="{DynamicResource ForegroundSecondary}"/>
                </TextBlock>

                <!-- Tray Icon -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Tray Icon"
                           Style="{StaticResource SectionHeader}"/>

                <TextBlock TextWrapping="Wrap"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           Margin="0,0,0,16">
                    <Run FontWeight="SemiBold" Text="Left-click or double-click:"/>
                    <Run Text=" Toggle all groups visible/hidden" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Right-click &#x2192; Show / Hide All:"/>
                    <Run Text=" Show or hide every group at once" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Right-click &#x2192; New Group:"/>
                    <Run Text=" Create a new empty group on your desktop" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Right-click &#x2192; Sort Ungrouped Icons:"/>
                    <Run Text=" See all ungrouped desktop shortcuts and add them to groups" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Right-click &#x2192; Settings:"/>
                    <Run Text=" Open this Settings window" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Right-click &#x2192; Restart DeskGroup:"/>
                    <Run Text=" Save all groups and restart the app" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run FontWeight="SemiBold" Text="Right-click &#x2192; Exit DeskGroup:"/>
                    <Run Text=" Close the application completely" Foreground="{DynamicResource ForegroundSecondary}"/>
                </TextBlock>

                <!-- Tips -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Tips &amp; Tricks"
                           Style="{StaticResource SectionHeader}"/>

                <TextBlock TextWrapping="Wrap"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           Margin="0,0,0,16">
                    <Run Text="• Drag the group header to reposition it anywhere on screen" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Double-click the group header to toggle pin (lock/unlock position)" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Drag an icon within a group to reorder it" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Drag an icon from one group and drop it onto another group to move it between groups" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Drag a desktop shortcut directly onto a group to add it" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Drag an icon off a group window to remove it from the group" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Drag the resize grip (bottom-right corner) in Normal or Grid view to set a custom size" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Scroll the mouse wheel over the Transparency slider for fine-grained control" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Click the footer bar on a minimized group to restore it to Sticky mode after Show All" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Hover over any icon to see a glow highlight — click once to launch" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Edge Dock icons are center-aligned, display their shortcut names in a delayed hover tooltip (hides immediately on mouse-out) to save screen space, close the dock on icon click even when Auto-Hide is off, and automatically stay consolidated on your primary screen across power outages or monitor wake order changes" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Enable Snap to Grid for perfectly aligned group layouts" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Use Sticky mode to keep groups behind your windows like classic desktop gadgets" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Right-click group → Appearance → Icon Size &amp; Opacity to give a specific group its own icon size and transparency that overrides the global setting" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Enable Single-click to open in Settings so shortcuts launch on a single click instead of a double-click" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Enable Detect new desktop icons in Settings to get notified when new shortcuts appear on the desktop" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Groups and positions are saved automatically; backups are kept in %APPDATA%\DeskGroup" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• In Settings &#x2192; Hotkeys, choose Keyboard / Mouse / Both for each action — assign a mouse button (MiddleClick, XButton1, ScrollUp, etc.) as an alternative or combined trigger" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• Enable Shell context menu in Settings then Apply; right-click any .lnk or .url file and choose 'Add to DeskGroup' (on Windows 11: right-click &#x2192; Show more options first)" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• A loading cursor appears briefly when launching a shortcut — normal for slow-starting apps; it resets automatically after a few seconds" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• If DeskGroup is already running, double-clicking its taskbar or desktop shortcut will show all your groups instead of silently doing nothing" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• On first launch, a setup wizard helps you choose your theme, transparency, hotkeys, startup behaviour and update preferences — you can re-run these from Settings at any time" Foreground="{DynamicResource ForegroundSecondary}"/>
                    <LineBreak/>
                    <Run Text="• To opt in for crash reporting go to Settings → Developer → Opt-in for bug reports; if enabled, a crash will open a pre-filled GitHub Issues page in your browser (nothing is sent automatically)" Foreground="{DynamicResource ForegroundSecondary}"/>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Updates Panel -->
        <ScrollViewer x:Name="UpdatesPanel"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,24,24,24"
                      Visibility="Collapsed">
            <StackPanel MaxWidth="480">

                <!-- Current version + check button -->
                <TextBlock Text="Updates"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,8"/>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource DefaultFont}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource ForegroundSecondary}">
                        <Run Text="Current version: "/>
                        <Run x:Name="UpdateCurrentVersionRun" Text="—" FontWeight="SemiBold"/>
                    </TextBlock>
                </DockPanel>

                <!-- Status line -->
                <TextBlock Text="{Binding UpdateStatusText}"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource ForegroundSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <!-- Check for Update button + progress -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="🔍 Check for Update"
                            Command="{Binding CheckForUpdateCommand}"
                            Style="{DynamicResource DefaultButton}"
                            Padding="14,6"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding IsCheckingForUpdate, Converter={StaticResource InverseBool}}"/>
                    <Button Content="{Binding ReinstallButtonText}"
                            Command="{Binding ReinstallLatestCommand}"
                            Style="{DynamicResource DefaultButton}"
                            Padding="12,6"
                            Margin="0,0,8,0"
                            ToolTip="Re-download and install the latest release even if the version number is already installed"
                            Visibility="{Binding CanReinstallLatest, Converter={StaticResource BooleanToVisibility}}"
                            IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBool}}"/>
                    <!-- Downloading progress -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BooleanToVisibility}}">
                        <ProgressBar Value="{Binding DownloadProgress}"
                                     Minimum="0" Maximum="100"
                                     Width="140"
                                     Height="20"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DownloadProgress, StringFormat={}{0}%}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   Foreground="{DynamicResource ForegroundSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- Checking spinner (indeterminate) -->
                    <ProgressBar IsIndeterminate="True"
                                 Width="80" Height="20"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsCheckingForUpdate, Converter={StaticResource BooleanToVisibility}}"/>
                </StackPanel>

                <!-- Update available panel -->
                <Border Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibility}}"
                        Background="{DynamicResource BackgroundSecondary}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16,12"
                        Margin="0,8,0,12">
                    <StackPanel>
                        <TextBlock FontFamily="{DynamicResource DefaultFont}"
                                   FontSize="{DynamicResource FontSizeLarge}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundPrimary}"
                                   Margin="0,0,0,6">
                            <Run Text="🆕  Version "/>
                            <Run Text="{Binding AvailableVersion}" FontWeight="Bold"/>
                            <Run Text=" is available"/>
                        </TextBlock>
                        <!-- Release notes (scrollable, capped height) -->
                        <ScrollViewer MaxHeight="120"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,10">
                            <TextBlock Text="{Binding UpdateReleaseNotes}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⬆️  Update &amp; Restart"
                                    Command="{Binding InstallUpdateCommand}"
                                    Style="{DynamicResource AccentButton}"
                                    Padding="14,6"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBool}}"/>
                            <Button Content="Skip this version"
                                    Command="{Binding SkipThisUpdateCommand}"
                                    Style="{DynamicResource DefaultButton}"
                                    Padding="10,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ──────────────────────────────────────────────────────── -->
                <Border Style="{StaticResource SectionSeparator}"/>
                <TextBlock Text="Automatic Updates" Style="{StaticResource SectionHeader}"/>

                <DockPanel Style="{StaticResource SettingRow}">
                    <TextBlock Text="Auto-update" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding AutoUpdate}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="Check for updates every time DeskGroup starts, and once per week while running."
                           Style="{StaticResource SettingDesc}"/>

                <DockPanel Style="{StaticResource SettingRow}"
                           Visibility="{Binding AutoUpdate, Converter={StaticResource BooleanToVisibility}}">
                    <TextBlock Text="Auto-install" Style="{StaticResource SettingLabel}"
                               DockPanel.Dock="Left" Width="160"/>
                    <CheckBox IsChecked="{Binding AutoInstall}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Visibility="{Binding AutoUpdate, Converter={StaticResource BooleanToVisibility}}"
                           Text="If an update is found, download and install it automatically then restart DeskGroup."
                           Style="{StaticResource SettingDesc}"/>

                <!-- Changes apply note -->
                <TextBlock Text="Auto-update preferences are saved when you click Apply."
                           Style="{StaticResource SettingDesc}"
                           Margin="0,8,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom button bar (only visible on Settings tab) -->
        <Border x:Name="BottomButtonBar"
                Grid.Row="3"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel>
                <!-- Reset -->
                <Button Content="Reset to Defaults"
                        Command="{Binding ResetToDefaultsCommand}"
                        DockPanel.Dock="Left"
                        Style="{DynamicResource DefaultButton}"/>

                <!-- Apply + Close -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button Content="Apply"
                            x:Name="ApplyButton"
                            Click="ApplyButton_Click"
                            Style="{DynamicResource AccentButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="Close"
                            x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Style="{DynamicResource DefaultButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        </Grid>
    </Border>
</Window>
