<Window x:Class="DeskGroup.Views.UngroupedIconsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ungrouped Desktop Icons"
        Width="560" Height="480"
        MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Row style for each ungrouped icon -->
        <Style x:Key="IconRowBorder" TargetType="Border">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource BackgroundSecondary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BackgroundTertiary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundPrimary}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Header -->
                <RowDefinition Height="*"/>      <!-- Icon list -->
                <RowDefinition Height="Auto"/>   <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,8">
            <TextBlock Text="New Desktop Icons Found"
                       FontFamily="{DynamicResource DefaultFont}"
                       FontSize="{DynamicResource FontSizeTitle}"
                       FontWeight="Bold"
                       Foreground="{DynamicResource ForegroundPrimary}"/>

            <TextBlock Text="These shortcuts were found on your desktop that aren't in any group yet. Assign them to a group, or dismiss to be reminded later when new icons appear."
                       FontFamily="{DynamicResource DefaultFont}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource ForegroundSecondary}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>

            <!-- Quick actions -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Foreground="{DynamicResource ForegroundSecondary}"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeSmall}"
                           VerticalAlignment="Center">
                    <Run Text="{Binding UngroupedIcons.Count, Mode=OneWay}"/>
                    <Run Text=" ungrouped icon(s)"/>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Scrollable icon list -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="24,8,24,8">

            <ItemsControl ItemsSource="{Binding UngroupedIcons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource IconRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>   <!-- Icon -->
                                    <ColumnDefinition Width="*"/>      <!-- Name + path -->
                                    <ColumnDefinition Width="Auto"/>   <!-- Arrow -->
                                    <ColumnDefinition Width="160"/>    <!-- Group selector -->
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <Border Grid.Column="0"
                                        Width="36" Height="36"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Name + file path -->
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontFamily="{DynamicResource DefaultFont}"
                                               FontSize="{DynamicResource FontSizeNormal}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ForegroundPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FilePath}"
                                               FontFamily="{DynamicResource DefaultFont}"
                                               FontSize="{DynamicResource FontSizeSmall}"
                                               Foreground="{DynamicResource ForegroundDisabled}"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="220"
                                               ToolTip="{Binding FilePath}"/>
                                </StackPanel>

                                <!-- Arrow -->
                                <TextBlock Grid.Column="2"
                                           Text="Righti"
                                           FontSize="16"
                                           Foreground="{DynamicResource ForegroundSecondary}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Margin="8,0"/>

                                <!-- Group selector dropdown -->
                                <ComboBox Grid.Column="3"
                                          ItemsSource="{Binding DataContext.AvailableGroups, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          VerticalAlignment="Center"
                                          Padding="8,4"
                                          MinWidth="140">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="12" Height="12"
                                                        CornerRadius="2"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}" />
                                                <TextBlock Text="{Binding Name}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <TextBlock Grid.Row="1"
                   Text="All desktop icons are already grouped!"
                   FontFamily="{DynamicResource DefaultFont}"
                   FontSize="{DynamicResource FontSizeNormal}"
                   Foreground="{DynamicResource ForegroundSecondary}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UngroupedIcons.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Bottom button bar -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="24,12">
            <DockPanel>
                <!-- Dismiss all -->
                <Button Content="Dismiss All"
                        ToolTip="Dismiss these icons. You'll be reminded when new icons appear."
                        Command="{Binding DismissAllCommand}"
                        DockPanel.Dock="Left"
                        Style="{DynamicResource DefaultButton}"/>

                <!-- Apply + Close -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button Content="Apply Sorting"
                            x:Name="ApplySortButton"
                            Click="ApplySortButton_Click"
                            Style="{DynamicResource AccentButton}"
                            ToolTip="Add selected icons to their assigned groups"
                            Margin="0,0,8,0"/>
                    <Button Content="Close"
                            x:Name="CloseButton"
                            Click="CloseButton_Click"
                            Style="{DynamicResource DefaultButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        </Grid>
    </Border>
</Window>