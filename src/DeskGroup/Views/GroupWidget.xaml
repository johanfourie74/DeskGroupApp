<Window x:Class="DeskGroup.Views.GroupWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Name}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Topmost="False"
        AllowDrop="True"
        d:DesignWidth="320" d:DesignHeight="400">

    <Grid x:Name="RootContainer">

        <!-- MINIMIZED VIEW - Compact button -->
        <Border x:Name="MinimizedView"
                CornerRadius="8" 
                Background="{Binding AccentBrush, FallbackValue=#FF0078D4}"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                Padding="8"
                Cursor="SizeAll"
                MouseEnter="MinimizedView_MouseEnter"
                MouseLeave="MinimizedView_MouseLeave"
                MouseLeftButtonDown="Header_MouseLeftButtonDown"
                MouseLeftButtonUp="Header_MouseLeftButtonUp"
                MouseMove="Header_MouseMove">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name, FallbackValue='Group'}" 
                           Foreground="White"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Text=" (" 
                           Foreground="#CCFFFFFF"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>

                <TextBlock Text="{Binding AllShortcuts.Count, FallbackValue=0}" 
                           Foreground="#CCFFFFFF"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock Text=")" 
                           Foreground="#CCFFFFFF"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- HOVER VIEW - Quick preview with top shortcuts -->
        <Border x:Name="HoverView"
                CornerRadius="8"
                Background="{Binding AccentBrush, FallbackValue=#FF0078D4}"
                BorderBrush="#60FFFFFF"
                BorderThickness="2"
                Padding="10"
                Visibility="Collapsed"
                MouseLeave="HoverView_MouseLeave"
                MouseLeftButtonDown="Header_MouseLeftButtonDown"
                MouseLeftButtonUp="Header_MouseLeftButtonUp"
                MouseMove="Header_MouseMove"
                Cursor="SizeAll">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header (no drag handlers - Border handles it) -->
                <TextBlock Grid.Row="0"
                           Text="{Binding Name, FallbackValue='Group'}"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <!-- Top Shortcuts Preview (max 5) -->
                <ItemsControl Grid.Row="1"
                              ItemsSource="{Binding TopUsedShortcuts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#20FFFFFF"
                                    CornerRadius="4"
                                    Padding="6"
                                    Margin="0,2"
                                    Cursor="Hand"
                                    PreviewMouseLeftButtonDown="Shortcut_Click"
                                    MouseRightButtonUp="Shortcut_RightClick">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding IconImage}"
                                           Width="20" 
                                           Height="20"
                                           Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="White"
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- NORMAL VIEW - Full icon grid -->
        <Border x:Name="NormalView"
                CornerRadius="8"
                Background="{Binding AccentBrush, FallbackValue=#FF0078D4}"
                BorderBrush="#40FFFFFF"
                BorderThickness="2"
                Padding="10"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header with drag handle -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Name, FallbackValue='Group'}"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               MouseLeftButtonDown="Header_MouseLeftButtonDown"
                               MouseLeftButtonUp="Header_MouseLeftButtonUp"
                               MouseMove="Header_MouseMove"
                               Cursor="SizeAll"/>
                </Grid>

                <!-- Shortcuts Grid -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="400">
                    <ItemsControl ItemsSource="{Binding AllShortcuts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#20FFFFFF"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="2"
                                        Cursor="Hand"
                                        PreviewMouseLeftButtonDown="Shortcut_Click"
                                        MouseRightButtonUp="Shortcut_RightClick">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding IconImage}"
                                               Width="24" 
                                               Height="24"
                                               Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- GRID VIEW - Compact tile grid (between Normal and Fullscreen) -->
        <Border x:Name="GridView"
                CornerRadius="8"
                Background="{Binding AccentBrush, FallbackValue=#FF0078D4}"
                BorderBrush="#40FFFFFF"
                BorderThickness="2"
                Padding="10"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header with drag handle -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Name, FallbackValue='Group'}"
                               Foreground="White"
                               FontSize="16"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               MouseLeftButtonDown="Header_MouseLeftButtonDown"
                               MouseLeftButtonUp="Header_MouseLeftButtonUp"
                               MouseMove="Header_MouseMove"
                               Cursor="SizeAll"/>
                </Grid>

                <!-- Shortcuts in compact grid -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="500">
                    <ItemsControl ItemsSource="{Binding AllShortcuts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#20FFFFFF"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Width="80"
                                        Height="80"
                                        Margin="4"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="Shortcut_Click"
                                        MouseRightButtonUp="Shortcut_RightClick">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Image Source="{Binding IconImage}" 
                                               Width="32" 
                                               Height="32"
                                               Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="70"
                                                   MaxHeight="28"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- FULLSCREEN VIEW - Entire screen coverage -->
        <Border x:Name="FullscreenView"
                Background="{Binding AccentBrush, FallbackValue=#FF0078D4}"
                Visibility="Collapsed">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with close button -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="{Binding Name, FallbackValue='Group'}"
                               Foreground="White"
                               FontSize="32"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Press ESC to exit fullscreen"
                               Foreground="#CCFFFFFF"
                               FontSize="16"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Shortcuts in large grid -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding AllShortcuts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Background="#20FFFFFF"
                                        BorderBrush="#40FFFFFF"
                                        BorderThickness="1"
                                        Width="120"
                                        Height="120"
                                        Margin="8"
                                        Cursor="Hand"
                                        Padding="8"
                                        Click="Shortcut_Click"
                                        MouseRightButtonUp="Shortcut_RightClick">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Source="{Binding IconImage}" 
                                               Width="48" 
                                               Height="48"
                                               Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="White"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="100"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Footer info -->
                <TextBlock Grid.Row="2"
                           Text="{Binding AllShortcuts.Count, StringFormat='{}{0} shortcuts'}"
                           Foreground="#CCFFFFFF"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </Grid>
        </Border>

    </Grid>

    <!-- Context menu -->
    <Window.ContextMenu>
        <ContextMenu>
            <!-- View Mode -->
            <MenuItem Header="View Mode">
                <MenuItem Header="Minimized" Click="SetMinimized_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="⬜" FontSize="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Normal" Click="SetNormal_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🗖" FontSize="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Grid" Click="SetGrid_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="▦" FontSize="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Fullscreen (F11)" Click="SetFullscreen_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="⛶" FontSize="12"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <Separator/>

            <!-- Add shortcut -->
            <MenuItem Header="Add shortcut..." x:Name="MenuAddShortcut"
                      Click="MenuAddShortcut_Click">
                <MenuItem.Icon>
                    <TextBlock Text="➕" FontSize="12"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>

            <!-- Appearance -->
            <MenuItem Header="Appearance">
                <MenuItem Header="Change color..." x:Name="MenuChangeColor"
                          Click="MenuChangeColor_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🎨" FontSize="12"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Change icon..." x:Name="MenuChangeIcon"
                          Click="MenuChangeIcon_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🖼️" FontSize="12"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <!-- Position -->
            <MenuItem Header="Position">
                <MenuItem Header="{Binding IsPinned, StringFormat='📌 Pin position ({0})'}"
                          Command="{Binding TogglePinCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding IsPinned, Mode=OneWay}"/>
                <MenuItem Header="Snap to grid"
                          Command="{Binding ToggleSnapToGridCommand}"
                          IsCheckable="True"
                          IsChecked="{Binding SnapToGrid, Mode=OneWay}"/>
                <Separator/>
                <MenuItem Header="Sticky (desktop layer)"
                          Command="{Binding ToggleDockModeCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="📌" FontSize="12"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <Separator/>

            <!-- Group settings -->
            <MenuItem Header="Rename..." x:Name="MenuRename"
                      Click="MenuRename_Click">
                <MenuItem.Icon>
                    <TextBlock Text="✏️" FontSize="12"/>
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>

            <!-- Delete group -->
            <MenuItem Header="Delete group" x:Name="MenuDeleteGroup"
                      Click="MenuDeleteGroup_Click">
                <MenuItem.Icon>
                    <TextBlock Text="🗑️" FontSize="12"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

</Window>