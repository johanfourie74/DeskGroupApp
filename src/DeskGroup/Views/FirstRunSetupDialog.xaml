<Window x:Class="DeskGroup.Views.FirstRunSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskGroup.Controls"
        Title="Welcome to DeskGroup"
        Width="540"
        Height="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource BackgroundPrimary}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- â•â•â• HEADER â•â•â• -->
            <StackPanel Grid.Row="0" Margin="32,28,32,16">
                <Image Source="/Assets/dg_icon.png"
                       Width="56" Height="56"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>
                <TextBlock Text="Welcome to DeskGroup!"
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundPrimary}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Let's get you set up! All options can be changed at any time in Settings."
                           FontFamily="{DynamicResource DefaultFont}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           Foreground="{DynamicResource ForegroundSecondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,16"/>
                <Border Height="1" Background="{DynamicResource BorderSubtle}"/>
            </StackPanel>

            <!-- â•â•â• SCROLLABLE CONTENT â•â•â• -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="32,8,32,8">
                <StackPanel>

                    <!-- â•â• APPEARANCE â•â• -->
                    <TextBlock Text="ðŸŽ¨  Appearance"
                               FontFamily="{DynamicResource DefaultFont}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               Margin="0,8,0,10"/>

                    <!-- Theme -->
                    <DockPanel Margin="0,0,0,4">
                        <StackPanel DockPanel.Dock="Left" Width="280">
                            <TextBlock Text="Theme"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="Choose how DeskGroup looks â€” Light, Dark, or automatically follow your Windows colour scheme."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,8,0"/>
                        </StackPanel>
                        <ComboBox x:Name="CbTheme"
                                  VerticalAlignment="Center"
                                  Width="140" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Follow Windows"/>
                        </ComboBox>
                    </DockPanel>

                    <!-- Group Transparency -->
                    <DockPanel Margin="0,12,0,0">
                        <StackPanel DockPanel.Dock="Left" Width="280">
                            <TextBlock Text="Group transparency"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="How see-through the group panels are. 15% = nearly invisible; 85% = almost solid. The full 0â€“100% range is available in Settings."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,8,0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <Slider x:Name="SliderTransparency"
                                    Minimum="0.15" Maximum="0.85"
                                    Value="0.25"
                                    Width="120"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="SliderTransparency_ValueChanged"/>
                            <TextBlock x:Name="LblTransparency"
                                       Text="25%"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- â•â• DESKTOP INTEGRATION â•â• -->
                    <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,16,0,12"/>
                    <TextBlock Text="ðŸ–¥ï¸  Desktop Integration"
                               FontFamily="{DynamicResource DefaultFont}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               Margin="0,0,0,10"/>

                    <!-- Hide grouped icons -->
                    <DockPanel Margin="0,0,0,4">
                        <CheckBox x:Name="ChkHideGroupedIcons"
                                  IsChecked="True"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Left"
                                  Margin="0,3,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Hide grouped icons from the desktop"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="Shortcuts inside a group are hidden from the desktop â€” they live inside the group instead. Recommended for a tidy desktop."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Shell context menu -->
                    <DockPanel Margin="0,10,0,4">
                        <CheckBox x:Name="ChkShellContextMenu"
                                  IsChecked="False"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Left"
                                  Margin="0,3,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Add 'Add to DeskGroup' to right-click menu"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="Adds a quick option when you right-click any .lnk or .url file. On Windows 11 you may need 'Show more options' first."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- â•â• HOTKEYS â•â• -->
                    <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,16,0,12"/>
                    <TextBlock Text="âŒ¨ï¸  Hotkeys"
                               FontFamily="{DynamicResource DefaultFont}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               Margin="0,0,0,10"/>

                    <!-- Toggle all groups -->
                    <TextBlock Text="Toggle all groups (show / hide)"
                               FontFamily="{DynamicResource DefaultFont}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundPrimary}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Press this shortcut to instantly show or hide all groups. Click ðŸŽ¯ in a box to record your preferred key. Leave blank to disable."
                               FontFamily="{DynamicResource DefaultFont}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource ForegroundSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="âŒ¨ï¸" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13" ToolTip="Keyboard hotkey"/>
                        <controls:HotkeyBox x:Name="HkToggleAll"
                                            CaptureMode="KeyboardOnly"
                                            Width="130" HorizontalAlignment="Left"/>
                        <TextBlock Text="ðŸ–±ï¸" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="13" ToolTip="Mouse button hotkey"/>
                        <controls:HotkeyBox x:Name="HkToggleMouse"
                                            CaptureMode="MouseOnly"
                                            Width="130" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <!-- Fullscreen toggle -->
                    <TextBlock Text="Toggle fullscreen"
                               FontFamily="{DynamicResource DefaultFont}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundPrimary}"
                               Margin="0,10,0,4"/>
                    <TextBlock Text="Press this key while a group is active to switch it to full-screen view. Press F11 or ESC to exit at any time."
                               FontFamily="{DynamicResource DefaultFont}"
                               FontSize="{DynamicResource FontSizeSmall}"
                               Foreground="{DynamicResource ForegroundSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="âŒ¨ï¸" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13" ToolTip="Keyboard hotkey"/>
                        <controls:HotkeyBox x:Name="HkFullscreenKey"
                                            CaptureMode="KeyboardOnly"
                                            Width="130" HorizontalAlignment="Left"/>
                        <TextBlock Text="ðŸ–±ï¸" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="13" ToolTip="Mouse button hotkey"/>
                        <controls:HotkeyBox x:Name="HkFullscreenMouse"
                                            CaptureMode="MouseOnly"
                                            Width="130" HorizontalAlignment="Left"/>
                    </DockPanel>

                    <!-- â•â• STARTUP & BEHAVIOUR â•â• -->
                    <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,16,0,12"/>
                    <TextBlock Text="ðŸš€  Startup &amp; Behaviour"
                               FontFamily="{DynamicResource DefaultFont}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               Margin="0,0,0,10"/>

                    <!-- Start with Windows -->
                    <DockPanel Margin="0,0,0,4">
                        <CheckBox x:Name="ChkStartWithWindows"
                                  IsChecked="True"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Left"
                                  Margin="0,3,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Start with Windows"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="DeskGroup starts automatically when you log in so your groups are always there."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Start minimized -->
                    <DockPanel Margin="0,10,0,4">
                        <CheckBox x:Name="ChkStartMinimized"
                                  IsChecked="False"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Left"
                                  Margin="0,3,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Start minimized to tray"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="When DeskGroup starts, your groups load but stay hidden. Click the tray icon to reveal them."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Multi-monitor support -->
                    <DockPanel Margin="0,10,0,4">
                        <CheckBox x:Name="ChkMultiMonitor"
                                  IsChecked="True"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Left"
                                  Margin="0,3,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Multi-monitor support"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="Allows groups to be placed on any monitor. Each group remembers which screen it was on and returns there at next launch."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Desktop shortcut -->
                    <DockPanel Margin="0,10,0,4">
                        <CheckBox x:Name="ChkDesktop"
                                  IsChecked="True"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Left"
                                  Margin="0,3,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Add a desktop shortcut"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="Creates a DeskGroup shortcut on your desktop for quick access."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Pin to Start -->
                    <DockPanel Margin="0,10,0,4">
                        <CheckBox x:Name="ChkStart"
                                  IsChecked="False"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Left"
                                  Margin="0,3,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Pin to Start menu"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="Pins DeskGroup to your Windows Start menu. Requires the desktop shortcut above. On Windows 11 a manual step may be needed."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Pin to Taskbar -->
                    <DockPanel Margin="0,10,0,4">
                        <CheckBox x:Name="ChkTaskbar"
                                  IsChecked="False"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Left"
                                  Margin="0,3,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Pin to taskbar"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="Pins DeskGroup to your Windows taskbar. Requires the desktop shortcut above. On Windows 11 a manual step may be needed."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- â•â• UPDATES â•â• -->
                    <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,16,0,12"/>
                    <TextBlock Text="ðŸ”„  Updates"
                               FontFamily="{DynamicResource DefaultFont}"
                               FontSize="{DynamicResource FontSizeNormal}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               Margin="0,0,0,10"/>

                    <!-- Auto update -->
                    <DockPanel Margin="0,0,0,4">
                        <CheckBox x:Name="ChkAutoUpdate"
                                  IsChecked="False"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Left"
                                  Margin="0,3,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Check for updates automatically"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="DeskGroup quietly checks for new releases once a week and shows a notification if one is available."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Auto install -->
                    <DockPanel Margin="0,10,0,4">
                        <CheckBox x:Name="ChkAutoInstall"
                                  IsChecked="False"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Left"
                                  Margin="0,3,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Download and install updates automatically"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="When a new version is found, DeskGroup downloads the installer in the background and runs it for you. Requires 'Check for updates' above."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Opt-in bug reporting -->
                    <DockPanel Margin="0,10,0,12">
                        <CheckBox x:Name="ChkOptInBugReporting"
                                  IsChecked="False"
                                  VerticalAlignment="Top"
                                  DockPanel.Dock="Left"
                                  Margin="0,3,12,0"/>
                        <StackPanel>
                            <TextBlock Text="Opt in for bug reports and suggestions"
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeNormal}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundPrimary}"/>
                            <TextBlock Text="If DeskGroup crashes, you will be asked whether to report the issue. No data is sent automatically â€” it only opens a pre-filled GitHub Issues page in your browser so you can review and submit it yourself."
                                       FontFamily="{DynamicResource DefaultFont}"
                                       FontSize="{DynamicResource FontSizeSmall}"
                                       Foreground="{DynamicResource ForegroundSecondary}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- â•â•â• FOOTER â•â•â• -->
            <Border Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    Padding="32,14,32,20">
                <Button Content="Get Started  &#x2192;"
                        Click="GetStarted_Click"
                        Style="{DynamicResource DefaultButton}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        FontFamily="{DynamicResource DefaultFont}"
                        FontSize="{DynamicResource FontSizeNormal}"
                        FontWeight="SemiBold"
                        Padding="28,10"
                        HorizontalAlignment="Center"
                        Cursor="Hand"/>
            </Border>

        </Grid>
    </Border>

</Window>
