<Application x:Class="DeskGroup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">

    <!--
    ShutdownMode="OnExplicitShutdown" because we run from the system tray.
    The app stays alive even when all windows are closed.
    We call Application.Current.Shutdown() explicitly from the tray menu.
    -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Base styles (buttons, tiles, scrollbars) â€” always loaded -->
                <ResourceDictionary Source="Themes/Generic.xaml"/>

                <!-- Theme (swapped at runtime based on settings) -->
                <!-- Default to Light; App.xaml.cs will swap to correct theme on startup -->
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>